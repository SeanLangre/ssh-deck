[Desktop Entry]
Version=1.0
Type=Application
Name=SSH GUI Manager
Comment=Tkinter SSH Management GUI
Exec=/path/to/Python-Tkinter-Paramiko/venv/bin/python /path/to/Python-Tkinter-Paramiko/ssh_gui.py
Path=/path/to/Python-Tkinter-Paramiko
Icon=/usr/share/icons/HighContrast/48x48/apps/utilities-terminal.png
Terminal=false
Categories=Network;RemoteAccess;
StartupNotify=true
StartupWMClass=SshGuiManager
